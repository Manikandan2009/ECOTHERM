# Earth Engine credentials are stored by the Earth Engine authentication flow,
# not in this file. This project ID is used for Earth Engine initialization.
ECOTHERM_EARTH_ENGINE_PROJECT_ID=ecotherm-515613

# Override only when needed. The default cache path is <project-root>/data/cache.
# ECOTHERM_CACHE_DIR=C:\path\to\ECOTHERM\data\cache

# Open-Meteo Historical Weather API base URL.
ECOTHERM_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
ECOTHERM_OPEN_METEO_TIMEOUT_SECONDS=30
